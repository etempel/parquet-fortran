{
  "respectGitignore": false,
  "permissions": {
    "allow": [
      "Edit(//private/tmp/claude-501/**)",
      "Edit(//tmp/claude-501/**)",
      "Bash(mkdir -p /private/tmp/claude-501/*)",
      "Bash(chmod +x /private/tmp/claude-501/*)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git restore:*)",
      "Bash(git reset:*)",
      "Bash(git rm:*)",
      "Bash(git clean:*)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(docker build:*)",
      "Bash(tools/build_ci_test_image.sh:*)",
      "Bash(gitlab-runner:*)",
      "Bash(fpm publish:*)",
      "Edit(~/.zprofile)",
      "Edit(~/.zshrc)",
      "Edit(~/.bashrc)",
      "Edit(~/.activate_gcc.sh)",
      "Edit(~/.activate_nag.sh)",
      "Edit(~/.activate_flang.sh)",
      "Edit(//opt/fortran/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-feature-docs.sh",
            "timeout": 10,
            "statusMessage": "Checking the command against the feature_*.md rule"
          }
        ]
      }
    ]
  }
}
