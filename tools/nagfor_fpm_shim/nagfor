#!/bin/bash
# nagfor shim for building this project with fpm + NAG (FPM_FC=nagfor).
#
# fpm 0.13's NAG support needs four independent fixes to build this project
# -- three on the link line, one on the compile line (verified against fpm
# 0.13.0 alpha; the three link-line ones reported upstream to
# fortran-lang/fpm on 2026-08-19):
#
#   1. The `openmp = "*"` metapackage's link flag is appended to the build
#      model TWICE -- fpm's build_model resolves metapackages once before and
#      once after the dependency tree is built, and each pass appends. Every
#      compiler gets the doubled flag; gfortran silently tolerates
#      `-fopenmp -fopenmp`, NAG hard-errors
#      "Option error: -openmp option specified twice".
#   2. External libraries (fpm.toml's `link = [...]` and fpm's own C++
#      runtime `c++`) are emitted as `-Wl,<name>` instead of `-l<name>` for
#      NAG. nagfor's -Wl, forwards the bare word to the host C compiler
#      (clang on macOS), which reads it as an input filename:
#      "clang: error: no such file or directory: 'arrow'".
#   3. The macOS-only `-Wl,-headerpad,0x200` (gcc syntax for handing ld an
#      option) reaches clang as a raw ld option through nagfor's -Wl, and is
#      rejected with "clang: error: unknown argument: '-headerpad'". It is
#      TRANSLATED here rather than dropped, into the -Xlinker spelling clang
#      does accept. Upstream fix pending: fortran-lang/fpm PR #1312.
#
#      **Dropping it is NOT safe, although it looks it.** The flag reserves
#      Mach-O header padding for a later install_name_tool edit, and nothing
#      in `fpm build` or `fpm test` ever performs one -- but `fpm install`
#      does, adding two rpaths (`@executable_path/../lib` and
#      `@executable_path`) to the installed copy. Each LC_RPATH costs 40
#      bytes; without the flag ld64 leaves its default 32-byte pad plus
#      alignment slack, which measured 56 bytes on this project. The first
#      rpath fits, the second does not, and `fpm install` dies with
#      "larger updated load commands do not fit (the program must be
#      relinked, and you may need to use -headerpad or
#      -headerpad_max_install_names)". The translated flag reserves 0x200
#      (512) bytes, which measured as a 520-byte pad -- room for both.
#
# Usage: prepend this directory to PATH before running fpm with FPM_FC=nagfor
# (e.g. from the shell script that activates the NAG environment):
#
#   export PATH="/path/to/parquet-fortran/tools/nagfor_fpm_shim:$PATH"
#
# The file is named exactly `nagfor` so fpm's compiler identification (which
# keys on the command name) is unaffected; the shim execs the real nagfor
# found further along PATH. Remove the PATH line once fpm's link-line
# construction is fixed upstream.
#
# 4. fpm's compile-side OpenMP probe fails under NAG (fpm hands nagfor
#    `-fPIC`, which NAG rejects -- its spelling is `-PIC`), so fpm puts
#    `-openmp` on the LINK line only and never on a compile line. Left alone
#    that makes every NAG build SERIAL -- each `#ifdef _OPENMP` block compiles
#    out, 15 threading tests skip, and a green NAG run says nothing at all
#    about the parallel paths (1768 passed / 15 skipped, against 1783 / 0
#    with the flag). So this shim SUPPLIES `-openmp` itself: every invocation
#    gets exactly one, added when absent and deduplicated when fpm's doubled
#    link flag or a profile already provides it.
#
#    The -fPIC probe is deliberately still NOT translated to -PIC. Flipping it
#    would make fpm add its own compile-side `-openmp` on top of this one --
#    two mechanisms for one flag, and the doubling is exactly what item 1
#    above already has to clean up. Supplying it here keeps it to one place
#    that can be read and turned off.
#
#    NAGFOR_OMP controls it: unset or 1 (the default) supplies the flag, 0
#    opts out for a deliberately serial NAG build -- and 0 also STRIPS an
#    -openmp that fpm or anything else passed, rather than merely declining to
#    add one, so it cannot be silently overridden by a profile or a --flag
#    that supplies the option. (fpm.toml's nagfor.flags no longer carries one:
#    it became redundant once this shim supplied it. The stripping is what
#    keeps the switch honest if it ever comes back.) That serial build is a
#    real configuration and worth keeping reachable: it is what exercises
#    this project's `#ifndef _OPENMP` arms and proves its skip guards
#    actually skip (see CLAUDE.md, "A test that asserts THREADING must skip
#    without OpenMP") -- a guard that fires unconditionally passes every test
#    ever written for it. Measured 2026-08-20 with a bare `fpm test` under
#    FPM_FC=nagfor and no profile flags: 1783 passed / 0 skipped by default,
#    1768 / 15 under NAGFOR_OMP=0.
#
#    `fpm --verbose` WILL NOT SHOW THE FLAG, and that is expected rather than
#    evidence it is absent. fpm prints the command line it constructs and then
#    hands to `nagfor`; every rewrite this shim makes -- this addition, the
#    `-Wl,` fixes, the deduplication -- happens afterwards, before exec'ing the
#    real compiler, so none of it is visible in fpm's output by construction.
#    `--show-model` has the same blind spot for the same reason. VERIFY BY
#    BEHAVIOUR INSTEAD: run something that asserts threading. The
#    `string_parallel` suite reports 9 passed / 0 skipped when the build really
#    is threaded, and 1 / 8 under NAGFOR_OMP=0.

# Resolve the real nagfor: first PATH entry whose nagfor is not this script.
real_nagfor=""
self="$0"
oldIFS=$IFS
IFS=':'
for dir in $PATH; do
    [ -z "$dir" ] && dir="."
    cand="$dir/nagfor"
    [ -f "$cand" ] && [ -x "$cand" ] || continue
    [ "$cand" -ef "$self" ] && continue
    real_nagfor="$cand"
    break
done
IFS=$oldIFS

if [ -z "$real_nagfor" ]; then
    echo "tools/nagfor_fpm_shim/nagfor: no real nagfor found on PATH beyond this shim" >&2
    exit 127
fi

# NAGFOR_OMP is a master switch, not merely a "do not add" flag: at 0 it also
# drops an -openmp that fpm or a profile supplied, since all three NAG
# profiles in fpm.toml carry one and an opt-out that they silently override
# would be worse than none -- it would report a serial arm that never ran.
omp_off=0
[ "${NAGFOR_OMP:-1}" = "0" ] && omp_off=1

args=()
seen_openmp=0
for a in "$@"; do
    case "$a" in
        -openmp)
            [ "$omp_off" = "1" ] && continue
            [ "$seen_openmp" = "1" ] && continue
            seen_openmp=1
            ;;
        -Wl,-headerpad,0x200)
            # fpm's gcc spelling; clang rejects a bare -headerpad, but takes
            # it through -Xlinker. Dropping it instead breaks `fpm install`
            # -- see item 3 above.
            a="-Wl,-Xlinker,-headerpad,-Xlinker,0x200" ;;
        -Wl,-*)
            : ;;                 # other dash passthroughs: leave untouched
        -Wl,*)
            a="-l${a#-Wl,}" ;;   # bare name: fpm meant an external library
    esac
    args+=("$a")
done

# Supply -openmp when nothing else did (item 4 above). fpm cannot: its
# compile-side probe fails on -fPIC, so it only ever puts the flag on the
# link line. NAGFOR_OMP=0 opts out; unset or anything else means on.
if [ "$seen_openmp" = "0" ] && [ "$omp_off" = "0" ]; then
    args+=("-openmp")
fi

exec "$real_nagfor" "${args[@]}"
