survey: The Big Survey
dataset: input_data
table: input_table
version: 1.3
date: '2025-09-01'
author: Dave Smith <dave_smith_is_not_here@gmail.com>
description: Just an example.
MAML_version: 1.2
extra:
  whatever: ei midagi
  col_map:
  - id: uberid
  - RA: ra_J2000
  yet_another: testing
fields:
- name: uberid
  ucd:
  - meta.id
  - meta.main
  info: ID field.
  data_type: int32
  qc:
    min: 1
    max: 1000
    miss: 'Null'
- name: ra_J2000
  unit: deg
  info: Right ascension (J2000)
  ucd: pos.eq.ra
  data_type: float64
  array_size:
  col_size:
  qc:
    min: '>= 0'
    max: '< 360'
    miss: 'Null'
- name: Dec
  unit: deg
  info: Declination (J2000)
  ucd:
  - pos.eq.dec
  data_type: float64
  array_size:
  col_size:
  qc:
    min: -90
    max: 90
    miss: 'Null'
