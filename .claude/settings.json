{
  "respectGitignore": false,
  "permissions": {
    "allow": [
      "Bash(fpm build:*)",
      "Bash(fpm test:*)",
      "Bash(fpm clean --skip)",
      "Bash(tools/run_lint_check.sh:*)",
      "Bash(python3 tools/check_source_conventions.py:*)",
      "Bash(python3 tools/check_doc_anchors.py:*)",
      "Bash(python3 tools/check_bindc_boundary.py:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git stash:*)",
      "Bash(git tag -l:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(awk:*)",
      "Bash(sed -n:*)",
      "Bash(NAGFOR_OMP:*)",
      "Bash(ford docs.md)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git restore:*)",
      "Bash(git reset:*)",
      "Bash(git rm:*)",
      "Bash(git clean:*)",
      "Bash(rm -r:*)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(docker build:*)",
      "Bash(tools/build_ci_test_image.sh:*)",
      "Bash(gitlab-runner:*)",
      "Bash(fpm publish:*)",
      "Edit(~/.zprofile)",
      "Edit(~/.zshrc)",
      "Edit(~/.bashrc)",
      "Edit(~/.activate_gcc.sh)",
      "Edit(~/.activate_nag.sh)",
      "Edit(//opt/fortran/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-feature-docs.sh",
            "timeout": 10,
            "statusMessage": "Checking the command against the feature_*.md rule"
          }
        ]
      }
    ]
  }
}
